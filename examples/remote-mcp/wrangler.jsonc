{
  // pmorun-mcp-poc — OSS PoC worker (workers.dev only; mcp.pmo.run is NOT this).
  // Deploys with CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID in the environment;
  // the account id is deliberately not committed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pmorun-mcp-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  }
  // Secrets (set via `wrangler secret put`, never committed):
  // - AUTH_TOKEN: shared-secret bearer token gating POST /mcp.
}
