---
import Base from "../../layouts/Base.astro";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ja" } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const features = [
  { title: t("landing.features.tco.title"), desc: t("landing.features.tco.desc") },
  { title: t("landing.features.compare.title"), desc: t("landing.features.compare.desc") },
  { title: t("landing.features.breakeven.title"), desc: t("landing.features.breakeven.desc") },
];

const trustItems = [
  t("landing.trust.opensource"),
  t("landing.trust.privacy"),
  t("landing.trust.noaccount"),
  t("landing.trust.api"),
];
---

<Base wide>
  <section class="py-24 text-center max-w-3xl mx-auto">
    <h1 class="text-5xl font-bold tracking-tight">{t("landing.hero")}</h1>
    <p class="text-xl text-gray-600 mt-6 max-w-2xl mx-auto">
      {t("landing.sub")}
    </p>
    <a
      href={`/${lang}/tools/tco/`}
      class="mt-8 inline-block bg-gray-900 text-white px-8 py-4 rounded-lg font-medium hover:bg-gray-800 text-lg"
    >
      {t("landing.cta")}
    </a>
  </section>

  <section class="py-8 border-y border-gray-100">
    <div class="flex flex-wrap justify-center gap-8 text-sm text-gray-500">
      {trustItems.map((item, i) => (
        <>
          {i > 0 && <span aria-hidden="true">&middot;</span>}
          <span>{item}</span>
        </>
      ))}
    </div>
  </section>

  <section class="py-20">
    <h2 class="text-2xl font-bold text-center mb-12">{t("landing.features.title")}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map(({ title, desc }) => (
        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold mb-2">{title}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-12 text-center">
    <a
      href={t("landing.secondary.url")}
      class="text-gray-500 hover:text-gray-900 underline text-sm"
      target="_blank"
    >
      {t("landing.secondary.text")}
    </a>
  </section>
</Base>
