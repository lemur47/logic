---
import Base from "../../../layouts/Base.astro";
import SectionHead from "../../../components/SectionHead.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ja" } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const tools = [
  { href: `/${lang}/tools/tco/`, label: "TCO", name: t("tools.tco"), desc: t("tools.tco.desc") },
  { href: `/${lang}/tools/pert/`, label: "PERT", name: t("tools.pert"), desc: t("tools.pert.desc") },
  { href: `/${lang}/tools/breakeven/`, label: "Break-even", name: t("tools.breakeven"), desc: t("tools.breakeven.desc") },
];
---

<Base title={t("tools.title")} bleed>
  <section class="section section--tight">
    <SectionHead num="00" label="tools" title={t("tools.title")} />
    <div class="grid-3">
      {tools.map(({ href, label, name, desc }) => (
        <a href={href} class="cell" style="text-decoration:none;color:inherit;">
          <div class="label label--ink">{label}</div>
          <h3>{name}</h3>
          <p>{desc}</p>
          <div style="margin-top:8px;">
            <span class="chip chip--oss">OSS</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
