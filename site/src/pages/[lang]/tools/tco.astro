---
import Base from "../../../layouts/Base.astro";
import SectionHead from "../../../components/SectionHead.astro";
import TcoCalculator from "../../../components/svelte/TcoCalculator.svelte";
import { useTranslations } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ja" } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Base title={t("tools.tco")} bleed>
  <section class="section section--tight">
    <SectionHead num="02" label="tools · tco" title={t("tools.tco")} lede={t("tools.tco.desc")} />
    <TcoCalculator client:load lang={lang} />
  </section>
</Base>
