---
import Base from "../../../layouts/Base.astro";
import TcoCalculator from "../../../components/svelte/TcoCalculator.svelte";
import { useTranslations } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ja" } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Base title={t("tools.tco")} wide>
  <h1 class="text-3xl font-bold mb-4">{t("tools.tco")}</h1>
  <p class="text-gray-600 mb-8">{t("tools.tco.desc")}</p>
  <TcoCalculator client:load lang={lang} />
</Base>
