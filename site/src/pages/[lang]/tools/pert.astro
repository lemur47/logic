---
import Base from "../../../layouts/Base.astro";
import SectionHead from "../../../components/SectionHead.astro";
import PertCalculator from "../../../components/svelte/PertCalculator.svelte";
import { useTranslations } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ja" } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Base title={t("tools.pert")} bleed>
  <section class="section section--tight">
    <SectionHead num="01" label="tools · pert" title={t("tools.pert")} lede={t("tools.pert.desc")} />
    <PertCalculator client:load lang={lang} />
  </section>
</Base>
