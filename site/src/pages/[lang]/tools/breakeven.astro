---
import Base from "../../../layouts/Base.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ja" } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Base title={t("tools.breakeven")}>
  <h1 class="text-3xl font-bold mb-4">{t("tools.breakeven")}</h1>
  <p class="text-gray-600 mb-8">{t("tools.breakeven.desc")}</p>
  <div class="border rounded p-8 text-center text-gray-400">
    Coming soon
  </div>
</Base>
