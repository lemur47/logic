---
import Base from "../../../layouts/Base.astro";
import SectionHead from "../../../components/SectionHead.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ja" } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Base title={t("contact.title")} bleed>
  <section class="section section--tight">
    <SectionHead num="00" label="contact" title={t("contact.title")} lede={t("contact.body")} />
    <div style="display:flex;gap:14px;flex-wrap:wrap;">
      <a href="mailto:hi@pmo.run" class="btn">{t("contact.email")}</a>
      <a href="https://github.com/lemur47/logic" target="_blank" rel="noopener" class="btn btn--ghost">GitHub ↗</a>
    </div>
  </section>
</Base>
