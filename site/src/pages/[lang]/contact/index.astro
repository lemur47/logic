---
import Base from "../../../layouts/Base.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ja" } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Base title={t("contact.title")}>
  <h1 class="text-3xl font-bold mb-4">{t("contact.title")}</h1>
  <p class="text-gray-600 mb-6">{t("contact.body")}</p>
  <a
    href="mailto:hello@pmo.run"
    class="inline-block bg-gray-900 text-white px-6 py-3 rounded font-medium hover:bg-gray-800"
  >
    {t("contact.email")}
  </a>
</Base>
