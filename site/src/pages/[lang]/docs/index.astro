---
import Base from "../../../layouts/Base.astro";
import SectionHead from "../../../components/SectionHead.astro";
import { getCollection } from "astro:content";
import { useTranslations, parseEntryLocale } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ja" } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const allDocs = await getCollection("docs", (entry) => {
  const { lang: entryLang } = parseEntryLocale(entry.id);
  return entryLang === lang;
});

const docs = allDocs.sort((a, b) => a.data.order - b.data.order);
---

<Base title={t("docs.title")} bleed>
  <section class="section section--tight">
    <SectionHead num="00" label="docs" title={t("docs.title")} />

    {docs.length === 0 ? (
      <p class="muted">{t("docs.empty")}</p>
    ) : (
      <div class="grid-2">
        {docs.map((doc) => {
          const { slug } = parseEntryLocale(doc.id);
          return (
            <a href={`/${lang}/docs/${slug}/`} class="cell" style="text-decoration:none;color:inherit;">
              <div class="label">{`§${String(doc.data.order).padStart(2, "0")}`}</div>
              <h3>{doc.data.title}</h3>
              {doc.data.description && <p>{doc.data.description}</p>}
            </a>
          );
        })}
      </div>
    )}
  </section>
</Base>
