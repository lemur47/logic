---
import Mark from "./Mark.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/utils";
import { languages, type Lang } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname;

const links = [
  { href: `/${lang}/`, label: t("nav.home"), match: `/${lang}/`, exact: true },
  { href: `/${lang}/tools/`, label: t("nav.tools"), match: "/tools" },
  { href: `/${lang}/docs/`, label: t("nav.docs"), match: "/docs" },
  { href: `/${lang}/blog/`, label: t("nav.blog"), match: "/blog" },
  { href: `/${lang}/about/`, label: t("nav.about"), match: "/about" },
  { href: `/${lang}/contact/`, label: t("nav.contact"), match: "/contact" },
];

const stripSlash = (s: string) => s.replace(/\/+$/, "");
const isCurrent = (match: string, exact = false) =>
  exact ? stripSlash(path) === stripSlash(match) : path.includes(match);
---

<nav class="nav">
  <a href={`/${lang}/`} class="nav__brand" aria-label="pmo.run home">
    <Mark />
    <span>pmo.run</span>
    <span class="nav__brand-version">v0.4 · alpha</span>
  </a>

  <button
    class="nav__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-menu"
    aria-label={t("nav.menu")}
  >
    <span class="nav__toggle-bar"></span>
    <span class="nav__toggle-bar"></span>
    <span class="nav__toggle-bar"></span>
  </button>

  <div class="nav__links" id="nav-menu">
    {links.map(({ href, label, match, exact }) => (
      <a href={href} aria-current={isCurrent(match, exact) ? "page" : undefined}>{label}</a>
    ))}
  </div>

  <div class="nav__cta">
    <div class="nav__lang" role="group" aria-label="Language">
      {Object.entries(languages).map(([code, label]) => (
        <a
          href={getLocalizedPath(path, code as Lang)}
          class:list={[code === lang && "is-on"]}
          aria-current={code === lang ? "page" : undefined}
        >{label === "English" ? "EN" : "JA"}</a>
      ))}
    </div>
    <a href="https://github.com/lemur47/logic" class="btn btn--ghost btn--sm" target="_blank" rel="noopener">GitHub ↗</a>
  </div>
</nav>

<script>
  // Mobile nav toggle. Bundled by Astro (same-origin /_astro), CSP-safe.
  const nav = document.querySelector(".nav");
  const toggle = document.querySelector(".nav__toggle");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
