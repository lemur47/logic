---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  tags: string[];
}

const { lang, tags } = Astro.props;
const t = useTranslations(lang);

const tool = tags.includes("pert")
  ? { href: `/${lang}/tools/pert/`, title: t("blog.cta.pert"), desc: t("blog.cta.pert.desc") }
  : tags.includes("tco")
    ? { href: `/${lang}/tools/tco/`, title: t("blog.cta.tco"), desc: t("blog.cta.tco.desc") }
    : null;
---

{tool && (
  <aside class="not-prose spec" style="margin-top:56px;">
    <div class="spec__bar">
      <span>try it</span>
      <span>{tags.includes("pert") ? "pmo.pert" : "pmo.tco"}</span>
    </div>
    <div class="spec__body" style="text-align:center;">
      <p style="margin:0;font-size:17px;font-weight:500;">{tool.title}</p>
      <p style="margin:6px 0 16px;color:var(--ink-2);font-size:14px;">{tool.desc}</p>
      <a href={tool.href} class="btn">{tool.title} →</a>
    </div>
  </aside>
)}
