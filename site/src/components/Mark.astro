---
interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 22 22"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <rect x="0.5" y="0.5" width="21" height="21" stroke="currentColor" />
  <rect x="7" y="7" width="8" height="8" fill="var(--accent)" />
</svg>
