# HTTP security headers for the static site, applied by Cloudflare Pages.
#
# The CSP is scoped to what the built site actually loads (verified against dist/):
#   - scripts: Astro's island-hydration bootstraps are emitted INLINE, so
#     'unsafe-inline' is required; bundled islands live under /_astro (same-origin,
#     'self'). There are no external script origins. A hash/nonce-based CSP is a
#     future hardening — a static _headers file can't carry per-build script hashes
#     without regenerating them on every build.
#   - styles: inline style= attributes and Astro scoped <style> blocks -> 'unsafe-inline'.
#   - fonts: @fontsource, some inlined as data: URIs -> 'self' data:.
#   - no external origins; the calculators compute client-side (no fetch) -> connect-src 'self'.
#
# frame-ancestors 'none' (+ X-Frame-Options for older browsers) closes the
# clickjacking gap the security audit flagged.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
